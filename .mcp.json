{
  "mcpServers": {
    "funk": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/funk_mcp.py"
      ],
      "env": {
        "FUNK_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "FUNK_OUT": "~/funkbox-data/out",
        "FUNK_INPUTS": "~/funkbox-data/inputs",
        "FUNK_PROJECTS": "~/funkbox-data/projects",
        "FUNK_INBOX": "~/funkbox-data/inbox"
      }
    },
    "funk2": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/funk2_mcp.py"
      ],
      "env": {
        "FUNK_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "FUNK_OUT": "~/funkbox-data/out",
        "FUNK_INPUTS": "~/funkbox-data/inputs",
        "FUNK_PROJECTS": "~/funkbox-data/projects",
        "FUNK_INBOX": "~/funkbox-data/inbox"
      }
    },
    "reel": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--extra",
        "reel",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/reel_mcp.py"
      ],
      "env": {
        "FUNK_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "FUNK_OUT": "~/funkbox-data/out",
        "FUNK_INPUTS": "~/funkbox-data/inputs",
        "FUNK_PROJECTS": "~/funkbox-data/projects",
        "FUNK_INBOX": "~/funkbox-data/inbox"
      }
    },
    "studio": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/studio/studio_mcp.py"
      ],
      "env": {
        "FUNK_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "FUNK_OUT": "~/funkbox-data/out",
        "FUNK_INPUTS": "~/funkbox-data/inputs",
        "FUNK_PROJECTS": "~/funkbox-data/projects",
        "FUNK_INBOX": "~/funkbox-data/inbox"
      }
    }
  }
}
