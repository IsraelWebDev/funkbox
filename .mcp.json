{
  "mcpServers": {
    "funkbox": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--extra",
        "reel",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/funkbox.py",
        "serve"
      ],
      "env": {
        "FUNK_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "FUNK_OUT": "~/funkbox-data/out",
        "FUNK_INPUTS": "~/funkbox-data/inputs",
        "FUNK_PROJECTS": "~/funkbox-data/projects",
        "FUNK_INBOX": "~/funkbox-data/inbox"
      }
    }
  }
}
