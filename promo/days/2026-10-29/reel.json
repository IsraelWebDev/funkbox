{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "bpm": 110,
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/loop-party-poster.mp4",
        "loop": true
      },
      "duration": "beats:5",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "install",
      "source": {
        "image": "assets/card-install.png"
      },
      "duration": "beats:6",
      "transition_in": "zoom-punch",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.1
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            -0.02,
            -0.04
          ]
        ]
      },
      "caption": {
        "copy_id": "p1",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "nocredits",
      "source": {
        "video": "assets/loop-pop-moire.mp4",
        "loop": true
      },
      "duration": "beats:5",
      "transition_in": "flash",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p2",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "retake",
      "source": {
        "image": "assets/card-reel-json.png"
      },
      "duration": "beats:6",
      "transition_in": "push",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.02,
          0.3,
          0.55,
          0.2
        ],
        "at": [
          0.05,
          0.7
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p3",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "gpu",
      "source": {
        "image": "assets/scene-dog.jpg"
      },
      "duration": "beats:6",
      "transition_in": "zoom-punch",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.12
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            0.02,
            -0.03
          ]
        ]
      },
      "caption": {
        "copy_id": "p4",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "top"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}